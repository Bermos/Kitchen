{
  "name": "kitchen-auth",
  "version": "0.2.0",
  "private": true,
  "description": "Kitchen's identity provider: better-auth with the OAuth/OIDC provider plugin",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.27",
    "@better-auth/oauth-provider": "1.6.27",
    "@better-auth/passkey": "1.6.27",
    "@better-auth/sso": "1.6.27",
    "better-auth": "1.6.27",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
